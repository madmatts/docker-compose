<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- Basic TeamCity-friendly Maven settings.xml
       - Server credentials are read from environment variables (set in TeamCity build configuration)
       - A profile (teamcity) configures Nexus URLs on localhost (adjust ports/paths for your Nexus)
       - Mirror forwards all requests to Nexus to ensure dependencies/plugins go through Nexus
  -->

  <localRepository>${user.home}/.m2/repository</localRepository>
  <interactiveMode>false</interactiveMode>
  <offline>false</offline>

  <servers>
    <!-- server id must match the <distributionManagement>/<repository> id or the repository id used in your POMs -->
    <server>
      <id>local-nexus</id>
      <!-- TeamCity: define environment variables NEXUS_USERNAME and NEXUS_PASSWORD (or replace with secure values) -->
      <username>${env.NEXUS_USERNAME}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>

  <mirrors>
    <!-- mirrorOf="*" sends all repository requests through Nexus -->
    <mirror>
      <id>nexus-mirror</id>
      <name>Local Nexus mirror</name>
      <url>http://localhost:8081/repository/maven-public/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>teamcity</id>

      <repositories>
        <repository>
          <id>local-nexus-releases</id>
          <name>Local Nexus Releases</name>
          <url>http://localhost:8081/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>local-nexus-snapshots</id>
          <name>Local Nexus Snapshots</name>
          <url>http://localhost:8081/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>local-nexus-plugins</id>
          <name>Local Nexus Plugin Repo</name>
          <url>http://localhost:8081/repository/maven-public/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>teamcity</activeProfile>
  </activeProfiles>
</settings>